#!/usr/bin/env bash

step_start "1.version"

echo $HOPS_PREFIX $HOPS_ARCH > $WRKDIR/version

if command -v uv &> /dev/null
then
  uv pip freeze >> $WRKDIR/version
elif command -v conda &> /dev/null
then
  conda list --export >> $WRKDIR/version
else
  pip freeze >> $WRKDIR/version
fi

step_end "1.version"
