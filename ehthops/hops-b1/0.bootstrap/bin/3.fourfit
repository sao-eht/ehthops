#!/usr/bin/env bash

step_start "3.fourfit"

# To avoid empty/unset MAX_BASELINES_PER_JOB (e.g. if 0.launch was skipped).
MAX_BASELINES_PER_JOB=${MAX_BASELINES_PER_JOB:-15}

echo "2. Running fourfit..."
echo "  Container work directory, WRKDIR: \"$WRKDIR\""
echo "  Container HOPS data output, DATADIR:    \"$DATADIR\""
echo "  Maximum concurrent jobs in SLURM job array, JOBARRAY_CAP:    \"$JOBARRAY_CAP\""
echo "  (if JOBARRAY_CAP is empty, GNU parallel is used to parallelize fourfit on local machine/single node)."
echo "  Maximum baselines per fourfit job, MAX_BASELINES_PER_JOB:    \"$MAX_BASELINES_PER_JOB\""
echo "  Band, BAND:    \"$BAND\""

cd $WRKDIR
md5sum `which fourfit` > log/fourfit.md5

N=$(basename $PWD | sed 's/^\([0-9]*\)\..*/\1/')

# concatenate control files in order: all bands, band-specific, stage-specific (including past stages)
cat cf*_bx_* cf*_${BAND}_* > temp/cf_all
find . -maxdepth 1 -type f -name 'cf*' -not -name 'cf*_b?_*' -exec cat {} + >> temp/cf_all

# Find root files in $DATADIR
if [[ -n "${ZSH_VERSION:-}" ]]; then
    setopt NULL_GLOB
else
    shopt -s nullglob
fi
_rootfiles=( "$DATADIR"/*/*/??[^.]*.?????? )

if [[ ${#_rootfiles[@]} -eq 0 ]]; then
    error "No root files found in ${DATADIR}"
    if [[ -n "${ZSH_VERSION:-}" ]]; then
        unsetopt NULL_GLOB
    else
        shopt -u nullglob
    fi
    return 1
fi

if [[ -f "${WRKDIR}/log/fourfit_retry.txt" ]]; then
    info "Retry mode: $(wc -l < "${WRKDIR}/log/fourfit_retry.txt") fourfit tasks from previous incomplete run"
    cp "${WRKDIR}/log/fourfit_retry.txt" log/filelist.txt
    rm "${WRKDIR}/log/fourfit_retry.txt"
else
    # Build the task list. Each line is TAB-separated: ROOTFILE, fourfit "set"
    # override arguments ("-" means "no override, use temp/cf_all as-is").
    #
    # When a scan's baseline count exceeds MAX_BASELINES_PER_JOB it is split into
    # ceil(n/MAX_BASELINES_PER_JOB) fourfit tasks. Each task's exclusion set is
    # passed to fourfit via its "set <control-file-syntax>" argument (see
    # fourfit.doc), e.g. "set baseline AB or baseline CD skip true". fourfit
    # applies this with the same last-statement-wins semantics as a control file,
    # so existing "skip false/true" statements in temp/cf_all are honoured and
    # only ever narrowed further, without ever touching disk.
    : > log/filelist.txt # truncate the file to start fresh

    for _rootfile in "${_rootfiles[@]}"; do
        _scandir=$(dirname "$_rootfile")
        # Extract baselines found in the current scan directory
        _basefiles=( "$_scandir"/??..?????? )
        _n_baselines=${#_basefiles[@]}

        if (( _n_baselines <= MAX_BASELINES_PER_JOB )); then
            # "-" (rather than an empty field) marks "no override", since a
            # trailing empty column is fragile to split on reliably across
            # both `read` and GNU parallel's --colsep.
            printf '%s\t-\n' "$_rootfile" >> log/filelist.txt
            continue
        fi

        _bl_codes=()
        for _bf in "${_basefiles[@]}"; do
            _bn=$(basename "$_bf")
            _bl_codes+=( "${_bn:0:2}" )
        done

        for ((_i=0; _i<_n_baselines; _i+=MAX_BASELINES_PER_JOB)); do
            _setargs=""
            for _excluded in "${_bl_codes[@]:0:_i}" "${_bl_codes[@]:$((_i + MAX_BASELINES_PER_JOB))}"; do
                if [[ -z "$_setargs" ]]; then
                    _setargs="baseline $_excluded"
                else
                    _setargs="$_setargs or baseline $_excluded"
                fi
            done
            _setargs="$_setargs skip true"
            printf '%s\t%s\n' "$_rootfile" "$_setargs" >> log/filelist.txt
        done
    done
fi

if [[ -n "${ZSH_VERSION:-}" ]]; then
    unsetopt NULL_GLOB
else
    shopt -u nullglob
fi

_n_files=$(wc -l < log/filelist.txt)
_n_scans=$(cut -f1 log/filelist.txt | sort -u | wc -l)
_n_split_scans=$(cut -f1 log/filelist.txt | sort | uniq -c | awk '$1>1' | wc -l)

# if JOBARRAY_CAP is not set use GNU parallel to parallelize fourfit on local machine/single node.
if [[ -n "${JOBARRAY_CAP:-}" ]]; then
    if ! command -v sbatch >/dev/null 2>&1; then
        error "JOBARRAY_CAP=${JOBARRAY_CAP} but sbatch not found in PATH"
        return 1
    fi

    # WRKDIR is a plain shell variable (not exported by 0.launch) so must be
    # passed explicitly. HOPS_SETUP_SCRIPT is exported by ehthops_slurm.job
    # and is accounted for via --export=ALL.
    _cap=${JOBARRAY_CAP}
    echo "Submitting fourfit SLURM job array: $_n_files tasks (max: $_cap)"
    _t0=$(date +%s)

    # Generate the worker script and place it inside WRKDIR/temp. The quoted
    # heredoc delimiter ('FOURFIT_WORKER') prevents variable expansion at
    # write time; all variables are resolved by the worker at runtime from
    # its Slurm environment.
    cat > "$WRKDIR/temp/fourfit_worker.sh" << 'FOURFIT_WORKER'
#!/usr/bin/env bash
# WARNING::: Generated by 3.fourfit. DO NOT edit manually!!!
#
# Required env vars (provided via --export=ALL and explicit exports):
#   WRKDIR -- stage working directory (passed explicitly, not exported by 0.launch)
#   FILELIST -- path to log/filelist.txt (passed explicitly)
#   HOPS_SETUP_SCRIPT -- path to hops.bash (exported by ehthops_slurm.job)
#   DATADIR -- required by fourfit (exported by 0.launch)

# Source bashrc, as in the main Slurm job script.
source "$HOME/.bashrc"

# Set up HOPS environment (worker runs in a fresh Slurm environment).
HOPS_SETUP=false source "$HOPS_SETUP_SCRIPT"

# uv venv not sourced since fourfit is a C binary and does not need Python.

# Look up this task's (ROOTFILE, fourfit "set" override) pair (array is
# 1-indexed to match filelist line numbers). SETARGS is deliberately
# word-split (unquoted) below to become separate fourfit arguments;
# its content is fully controlled by 3.fourfit, so this is safe.
_line=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$FILELIST")
if [[ -z "$_line" ]]; then
    echo "ERROR: no entry for task ${SLURM_ARRAY_TASK_ID} in ${FILELIST}" >&2
    exit 1
fi
IFS=$'\t' read -r ROOTFILE SETARGS <<< "$_line"
[[ "$SETARGS" == "-" ]] && SETARGS=""

fourfit -c "$WRKDIR/temp/cf_all" ${SETARGS:+set $SETARGS} "$ROOTFILE" \
    > "$ROOTFILE.${SLURM_ARRAY_TASK_ID}.out" \
    2> "$ROOTFILE.${SLURM_ARRAY_TASK_ID}.err"
_rc=$?
_sig=$(( _rc - 128 ))

if [[ $_rc -ge 128 ]]; then
    case $_sig in
        9)  _signame="SIGKILL (likely OOM)" ;;
        15) _signame="SIGTERM (likely Slurm walltime)" ;;
        24) _signame="SIGXCPU (CPU time limit)" ;;
        *)  _signame="signal ${_sig}" ;;
    esac
    echo "ERROR: fourfit killed by ${_signame} (exit ${_rc}) on ${ROOTFILE}" >&2
    echo "${_line}" > "${WRKDIR}/log/slurm/${SLURM_ARRAY_TASK_ID}.retry"
    exit $_rc
elif [[ $_rc -ne 0 ]]; then
    echo "NOTE: fourfit: ${_rc} fringe failure(s) on $(basename "${ROOTFILE}")" >&2
fi
FOURFIT_WORKER
    chmod +x "$WRKDIR/temp/fourfit_worker.sh"

    mkdir -p "$WRKDIR/log/slurm"

    _array_jid=$(sbatch \
        --parsable \
        --array=1-${_n_files}%${_cap} \
        --ntasks=1 --cpus-per-task=1 \
        --mem=4G \
        --time=4:00:00 \
        --output=/dev/null \
        --error="$WRKDIR/log/slurm/%a.err" \
        --partition="${SLURM_JOB_PARTITION:-blackhole}" \
        ${SLURM_JOB_ACCOUNT:+--account="$SLURM_JOB_ACCOUNT"} \
        --export=ALL,WRKDIR="$WRKDIR",FILELIST="$WRKDIR/log/filelist.txt" \
        "$WRKDIR/temp/fourfit_worker.sh") \
        || { error "sbatch failed"; return 1; }

    echo "Array job $_array_jid submitted, waiting..."
    while squeue --job "$_array_jid" --noheader 2>/dev/null | grep -q .; do
        sleep 30
    done

    _t1=$(date +%s)
    echo "Fourfit array $_array_jid completed in $((_t1 - _t0))s" | tee log/parallel.time
    find "$WRKDIR/log/slurm" -empty -delete

    find "$WRKDIR/log/slurm" -name "*.retry" -exec cat {} + \
    > "$WRKDIR/log/fourfit_retry.txt" 2>/dev/null
    find "$WRKDIR/log/slurm" -name "*.retry" -delete

else
    # Non-Slurm fallback: local GNU parallel, reading (ROOTFILE, fourfit "set"
    # override) pairs from the filelist built above. {2} is "-" for unsplit
    # scans, in which case no override is passed. GNU parallel's job sequence
    # number {#} matches the filelist line number and log/parallel.log's column
    # 1; so it doubles as a collision-free suffix for split scan logs.
    # $args is deliberately word-split (unquoted, via ${args:+set $args}) to
    # become separate fourfit arguments; see the SLURM worker script above for
    # why this is safe.
    (time parallel --nice 15 --load 95% --joblog log/parallel.log --colsep '\t' \
        'args={2}; [[ "$args" == "-" ]] && args=""; fourfit -c temp/cf_all ${args:+set $args} {1} > {1}.{#}.out 2> {1}.{#}.err' \
        :::: log/filelist.txt 2>&1) 2> log/parallel.time

    if [[ -f log/parallel.log ]]; then
        # A signal-killed command is usually a grandchild of parallel (it
        # runs the job through a shell because of the redirections above),
        # so the wrapping shell reports the translated 128+signal exit code
        # in Exitval ($7) while parallel's own Signal column ($8) stays 0.
        # Check both so OOM/walltime kills are reliably queued for retry.
        awk -F'\t' 'NR>1 && ($8+0>0 || $7+0>=128) {print $1}' log/parallel.log | \
            while IFS= read -r _seq; do
                sed -n "${_seq}p" log/filelist.txt
            done > log/fourfit_retry.txt
    fi

fi

cat "$DATADIR"/*/*/*.out > log/fourfit.out
cat "$DATADIR"/*/*/*.err > log/fourfit.err
cat log/slurm/*.err > log/fourfit_error_codes.err 2>/dev/null

# Handling fourfit exit codes
_signal_kills=0
if [[ -n "${JOBARRAY_CAP:-}" ]]; then
    if grep -q "killed by" log/fourfit_error_codes.err 2>/dev/null; then
        _signal_kills=1
    fi
else
    if [[ -f log/parallel.log ]] && \
       awk -F'\t' 'NR>1 && ($8+0>0 || $7+0>=128) {found=1; exit} END {exit !found}' log/parallel.log; then
        _signal_kills=1
    fi
fi

# Add summary of fourfit results
_n_submitted=$(wc -l < log/filelist.txt)
_n_kills=$(wc -l < log/fourfit_retry.txt 2>/dev/null || echo 0)

if [[ -n "${JOBARRAY_CAP:-}" ]]; then
    _n_failures=$(awk '/^NOTE: fourfit:/ {s+=$3} END {print s+0}' \
        log/fourfit_error_codes.err 2>/dev/null || echo 0)
else
    _n_failures=$(awk -F'\t' 'NR>1 && $8+0==0 && $7+0>0 && $7+0<128 {s+=$7} END {print s+0}' \
        log/parallel.log 2>/dev/null || echo 0)
fi

info "fourfit: ${_n_scans} scans submitted as ${_n_submitted} fourfit tasks (${_n_split_scans} scans split for load balancing), ${_n_kills} signal-killed, ${_n_failures} total fringe failures"

if [[ $_signal_kills -eq 1 ]]; then
    error "One or more fourfit tasks killed by signal, possibly OOM or walltime. Check log/fourfit_error_codes.err."
    error "Failed scans listed in log/fourfit_retry.txt. Re-run the pipeline to retry them."
else
    touch "${WRKDIR}/log/.done.3.fourfit"
fi

echo "DONE"

step_end "3.fourfit"
